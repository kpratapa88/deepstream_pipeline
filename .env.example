# Copy this file to .env and fill in your values
# .env is gitignored — never commit real credentials

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKER=localhost:9092
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CA=

# ── Pipeline ──────────────────────────────────────────────────────────────────
PIPELINE_LAUNCHER=subprocess
# PIPELINE_CONTAINER=deepstream   # set when using docker launcher

# ── Video streams (file paths or rtsp:// URIs) ────────────────────────────────
STREAM_URI_1=videos/sample1.mp4
STREAM_URI_2=videos/sample2.mp4
STREAM_URI_3=videos/sample3.mp4
STREAM_URI_4=videos/sample4.mp4

# ── Clip writer ───────────────────────────────────────────────────────────────
CLIPS_DIR=output/clips
PRE_EVENT_S=2
POST_EVENT_S=2
CLIP_FPS=30

# ── GPU ───────────────────────────────────────────────────────────────────────
GPU_ID=0
SERVER_ID=server_1
